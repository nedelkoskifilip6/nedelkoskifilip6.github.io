---
import { path } from '../data/site';
const artwork = path('brand/miku-vancouver-art-20261117.svg');
---
<svg class="brand-logo" viewBox="12 30 624 324" width="624" height="324" aria-hidden="true" focusable="false">
  <use class="brand-seal" href={`${artwork}#seal`} />
  <use class="brand-calligraphy" href={`${artwork}#calligraphy`} />
  <use class="brand-lettering" href={`${artwork}#lettering`} />
</svg>

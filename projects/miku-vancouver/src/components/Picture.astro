---
import { image } from '../data/site';
interface Props { name: string; alt: string; class?: string; eager?: boolean; fullResolution?: boolean; width?: number; height?: number; }
const { name, alt, class: className = '', eager = false, fullResolution = false, width = 2200, height = 1467 } = Astro.props;
---
<picture class={className}>
  <source media="(max-width: 700px)" srcset={image(name, !fullResolution)} width={fullResolution ? width : 900} height={fullResolution ? height : 1200} />
  <img src={image(name)} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
</picture>

---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { image, path } from '../data/site';
interface Props { title?: string; description?: string; hero?: boolean; }
const socialImage = new URL(path('social/hero-preview-20261015-aburi-v6.jpg'), Astro.site);
const { title = 'Miku Vancouver — The Art of Aburi', description = 'An independent fine-dining portfolio concept exploring Japanese craftsmanship, Aburi cuisine, and Vancouver’s Pacific coast. Not affiliated with Miku Vancouver.', hero = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#111111" /><meta name="description" content={description} />
    <title>{title}</title><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={path('brand/miku-seal-v3-20261015.ico')} />
    <link rel="icon" type="image/png" sizes="16x16" href={path('brand/miku-seal-16-v3-20261015.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={path('brand/miku-seal-32-v3-20261015.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={path('brand/miku-seal-192-v3-20261015.png')} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={path('brand/miku-seal-v3-20261015.svg')} />
    <link rel="apple-touch-icon" sizes="180x180" href={path('brand/miku-touch-v3-20261015.png')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Miku Vancouver — Independent Portfolio Concept" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content="The Art of Aburi — the Hero of an independent Miku Vancouver portfolio concept" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="The Art of Aburi — independent Miku Vancouver portfolio concept" />
    {hero && <><link rel="preload" as="image" href={image('hero-salmon-20261021')} media="(min-width: 701px)" /><link rel="preload" as="image" href={image('hero-salmon-20261021', true)} media="(max-width: 700px)" /></>}
  </head>
  <body id="top"><a class="skip-link" href="#main">Skip to content</a><Nav /><main id="main"><slot /></main><Footer />
    <script>import { initMotion } from '../scripts/motion'; initMotion();</script>
  </body>
</html>

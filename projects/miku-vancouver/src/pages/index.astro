---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Signature from '../components/Signature';
import Gallery from '../components/Gallery';
import Reservation from '../components/Reservation';
import { image, path, official } from '../data/site';
import research from '../data/research.json';
const courses = research.kaiseki.waterfront.courses;
const coursePhotos = ['oysters', 'salmon-nigiri', 'shellfish', 'fish-fillet', 'rolls-slate', 'wagashi'];
---
<Layout hero>
  <section class="opening-scene" aria-label="The art of Aburi">
    <div class="opening-pin">
      <div class="story-backdrop"></div>
      <div class="hero-image"><picture><source media="(max-width: 700px)" srcset={image('hero-salmon-20261021', true)} width="900" height="1266" /><img src={image('hero-salmon-wide-20261021')} alt="Salmon nigiri lifted with chopsticks above a dark plate; illustrative Japanese cuisine" width="1920" height="1080" loading="eager" decoding="async" fetchpriority="high" /></picture><div class="hero-shade"></div></div>
      <div class="hero-content">
        <p class="eyebrow hero-eyebrow"><span class="tiny-line"></span> JAPANESE SOUL. PACIFIC SPIRIT.</p>
        <h1 aria-label="The Art of Aburi"><span class="title-line"><span>THE ART</span></span><span class="title-line"><span>OF <i>ABURI</i><sup>炙り</sup></span></span></h1>
        <div class="hero-description"><p>Where Japanese Tradition<br />Meets the Pacific.</p><a class="button button-hero" href={path('menu/')}>Explore the menu</a></div>
      </div>
      <div class="hero-bottom"><span>VANCOUVER, CANADA<br /><small>A WATERFRONT PERSPECTIVE</small></span><a href="#story" class="scroll-cue"><span>SCROLL TO DISCOVER</span></a><p>Independent Portfolio Concept.<br />Not affiliated with Miku Vancouver.</p></div>
      <div class="aburi-story" aria-hidden="true">
        <p class="eyebrow"><span class="chapter-number">01</span> THE ART OF ABURI</p>
        <h2>FIRE.<br /><i>PRECISION.</i><br />PERFECTION.</h2>
        <div class="story-copy"><span class="japanese-detail" aria-hidden="true">炙</span><p>A moment of flame. A lifetime of craft.<br />Japanese technique meets the generosity of the Pacific coast. Aburi brings heat, texture and a new dimension to exceptional seafood.</p></div>
        <Picture name="craft" class="story-static-photo" alt="Hands preparing sushi; illustrative culinary craft" />
        <span class="image-footnote">EDITORIAL PHOTOGRAPHY · ILLUSTRATIVE</span>
      </div>
      <div class="scene-progress" aria-hidden="true"><span></span></div>
    </div>
  </section>

  <section class="story-section section-pad" id="story">
    <div class="story-heading"><p class="eyebrow" data-reveal>THE PHILOSOPHY</p><h2 data-reveal>Rooted in Japan.<br /><i>Reimagined by the Pacific.</i></h2></div>
    <div class="story-editorial"><div class="story-photo" data-reveal><Picture name="chef" alt="A chef shaping sushi by hand; illustrative culinary photography" /><span class="photo-caption">THE QUIET DISCIPLINE OF CRAFT · ILLUSTRATIVE IMAGE</span></div><div class="story-detail" data-reveal><span class="vertical-word" aria-hidden="true">手仕事</span><p>Since introducing Aburi cuisine to Vancouver in 2008, Miku has brought Japanese technique into conversation with the West Coast.</p><p>Carefully controlled flame transforms the surface of the seafood. Beneath it, delicate textures remain. The beauty is in that balance.</p><a class="text-link" href={official.home} target="_blank" rel="noopener noreferrer">Discover the restaurant</a><div class="craft-note"><span>火</span><p>ABURI / 炙り<br /><small>The art of flame searing.</small></p></div></div></div>
  </section>

  <section class="signature-section section-pad" id="signatures">
    <div class="section-heading" data-reveal><p class="eyebrow"><span class="chapter-number">02</span> THE SIGNATURE COLLECTION</p><div><h2>A taste of <i>the extraordinary.</i></h2><a class="text-link" href={path('menu/')}>Explore the full menu</a></div></div>
    <Signature client:visible />
  </section>

  <section class="dessert-editorial" aria-label="Green Tea Opera signature dessert">
    <div class="dessert-editorial-image"><Picture name="dessert" alt="A licensed matcha dessert composition; illustrative, not Miku’s Green Tea Opera" /></div>
    <div class="dessert-editorial-copy"><p class="eyebrow">THE SIGNATURE COLLECTION · A FINAL NOTE</p><h2>Beauty in<br /><i>every layer.</i></h2><a class="text-link" href={path('menu/?category=Desserts')}>Green Tea Opera</a></div>
    <div class="dessert-editorial-caption"><span>Illustrative matcha photography · not the actual dish</span><span>GREEN TEA OPERA · $17.50 CAD</span></div>
  </section>

  <section class="kaiseki-section" id="experience">
    <div class="kaiseki-intro section-pad"><p class="eyebrow" data-reveal><span class="chapter-number">03</span> KAISEKI · 懐石</p><h2 data-reveal>AN EXPERIENCE<br /><i>BEYOND DINING.</i></h2><div class="kaiseki-intro-bottom"><p data-reveal>A considered progression. A changing season.<br />Explore the six-course Waterfront Kaiseki.</p><p class="kaiseki-price" data-reveal>$135 <small>CAD / PERSON</small><span>Optional beverage pairing +$55</span></p></div></div>
    <div class="kaiseki-scenes">
      <div class="kaiseki-visual" aria-hidden="true">{courses.map((_, i) => <div class:list={['course-image', { active: i === 0 }]} data-course-image={i}><Picture name={coursePhotos[i]} alt="" /><div></div></div>)}<span class="kaiseki-visual-label">SIX MOMENTS. ONE EXPERIENCE.<small>Illustrative editorial imagery</small></span></div>
      <div class="course-chapters">{courses.map((course, i) => <article class="course-chapter" data-course={i}><div><p class="eyebrow">WATERFRONT KAISEKI</p><span class="course-number">0{i + 1}<small> / 06</small></span><h3>{course}</h3><p class="course-editorial">{['An opening gesture.', 'The purity of the Pacific.', 'A brighter expression.', 'Depth. Warmth. Balance.', 'A celebration of craft.', 'A graceful final note.'][i]}</p><span class="course-line"></span></div></article>)}</div>
    </div>
    <div class="kaiseki-outro"><p>Also explore Miku Kaiseki: seven courses, $180 CAD.<br /><small>Official dinner menu snapshot · October 14, 2026. Seasonal offerings may change.</small></p><a class="text-link" href={path('menu/?category=Kaiseki%20Experience')}>View the experiences</a></div>
  </section>

  <section class="gallery-section section-pad" id="gallery"><div class="section-heading" data-reveal><p class="eyebrow"><span class="chapter-number">04</span> A SENSE OF PLACE</p><div><h2>At the edge<br />of <i>the Pacific.</i></h2><p class="section-description">The waterfront. The intimacy of a table.<br />An editorial study of place and atmosphere.</p></div></div><Gallery client:visible /></section>

  <section class="private-section" id="private-dining"><div class="private-image" data-reveal><Picture name="private-dining-clean-v2-20261021" fullResolution width={1254} height={1254} alt="A waterfront dining room at dusk, with long white tables and pendant lights; user-supplied, AI-enhanced photograph" /></div><div class="private-copy section-pad" data-reveal><p class="eyebrow">PRIVATE DINING</p><h2>Some moments<br />deserve <i>their own space.</i></h2><p>Miku’s Blue Sky Room welcomes intimate gatherings of 7–20 guests. For celebrations, conversations and the occasions that stay with you.</p><a class="text-link" href={official.privateDining} target="_blank" rel="noopener noreferrer">Enquire with Miku</a><span class="image-footnote">USER-SUPPLIED PHOTOGRAPHY · AI ENHANCED</span></div></section>

  <section class="reservation-section section-pad" id="reservations"><div class="reservation-heading" data-reveal><p class="eyebrow"><span class="chapter-number">05</span> AN INVITATION</p><h2>YOUR TABLE<br /><i>AWAITS.</i></h2><p>A little anticipation.<br />An evening to remember.</p></div><div class="reservation-details" data-reveal><Reservation client:visible /><div class="address-block"><div><p class="eyebrow">FIND MIKU VANCOUVER</p><address>70–200 Granville Street<br />Vancouver, BC V6C 1S4<br /><small>Entrance on Howe Street.</small></address></div><a href="https://www.google.com/maps/search/?api=1&query=Miku+Vancouver+200+Granville+Street" target="_blank" rel="noopener noreferrer" class="map-link" aria-label="Find Miku Vancouver on Google Maps">View map</a></div></div></section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import MenuExplorer from '../components/MenuExplorer';
import { path } from '../data/site';
---
<Layout title="The Menu — Miku Vancouver Portfolio Concept">
  <section class="menu-page-intro section-pad"><p class="eyebrow">MIKU VANCOUVER · A CULINARY EXPLORATION</p><div><h1>A language<br />of <i>flavour.</i></h1><p>From a moment of flame<br />to a lasting impression.<br /><span>Explore the dinner collection.</span></p></div><span class="menu-page-kanji" aria-hidden="true">味</span></section>
  <section class="menu-page-body section-pad" aria-label="Interactive dinner menu"><MenuExplorer client:load /></section>
  <section class="menu-invitation section-pad"><p class="eyebrow">FROM SCREEN TO TABLE</p><h2>The next chapter<br />is <i>yours.</i></h2><a class="button button-ivory" href={path('#reservations')}>Your table awaits <span>↗</span></a></section>
</Layout>

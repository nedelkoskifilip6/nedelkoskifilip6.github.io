---
const assetBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const references = [
  { image: 'platform-symbol-v2.webp', width: 384, height: 204, alt: 'App platform symbols' },
  { image: 'trustpilot-symbol-v2.webp', width: 384, height: 373, alt: 'Green star symbol' },
  { image: 'globe-symbol-v2.webp', width: 375, height: 384, alt: 'Golden globe symbol' },
  { image: 'banking-symbol-v2.webp', width: 384, height: 272, alt: 'Green banking emblem' },
  { image: 'payments-symbol-v2.webp', width: 384, height: 254, alt: 'Green payments motif' },
  { image: 'satisfaction-symbol-v2.webp', width: 293, height: 384, alt: 'Gold star on a teal badge' },
  { image: 'guardian-symbol-v2.webp', width: 291, height: 384, alt: 'Green shield on a teal badge' },
];
---

<aside id="recognition" class="recognition-marquee" aria-label="Recognition reference symbols" data-recognition-marquee data-paused="false" data-in-view="false" data-document-visible="true">
  <button class="recognition-toggle" type="button" aria-label="Pause recognition animation" aria-pressed="false" data-recognition-toggle>
    <span class="sr-only" data-recognition-toggle-label>Pause</span>
    <svg class="recognition-pause-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M9 5v14M15 5v14"/></svg>
    <svg class="recognition-resume-icon" viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M8 5.5a1 1 0 0 1 1.5-.86l10 6.5a1 1 0 0 1 0 1.72l-10 6.5A1 1 0 0 1 8 18.5z"/></svg>
  </button>
  <div class="recognition-viewport" tabindex="0" aria-label="Recognition reference images" aria-live="off">
    <div class="recognition-track">
      <ul class="recognition-group">
        {references.map(reference => (
          <li class="recognition-item">
            <img src={`${assetBase}/images/recognition/${reference.image}`} width={reference.width} height={reference.height} alt={reference.alt} loading="lazy" decoding="async"/>
          </li>
        ))}
      </ul>
      <ul class="recognition-group recognition-copy" aria-hidden="true" inert>
        {references.map(reference => (
          <li class="recognition-item">
            <img src={`${assetBase}/images/recognition/${reference.image}`} width={reference.width} height={reference.height} alt="" loading="lazy" decoding="async"/>
          </li>
        ))}
      </ul>
    </div>
  </div>
</aside>

<style>
  .recognition-marquee { --recognition-item-width:112px; --recognition-gap:16px; position:relative; max-width:940px; min-width:0; margin:0 auto 32px; padding:6px 48px 18px 0; border-bottom:1px solid #e8e9e5; }
  .recognition-toggle { position:absolute; right:0; top:calc(50% - 9px); transform:translateY(-50%); display:grid; place-items:center; width:36px; height:36px; padding:0; border:1px solid #dde1dd; border-radius:50%; background:#fff; color:#646b66; cursor:pointer; }
  .recognition-toggle::before { content:''; position:absolute; inset:-4px; }
  .recognition-toggle:hover { color:#101114; background:#f4f6f3; }
  .recognition-resume-icon { display:none; }
  .recognition-marquee[data-paused="true"] .recognition-pause-icon { display:none; }
  .recognition-marquee[data-paused="true"] .recognition-resume-icon { display:block; }
  .recognition-viewport { width:100%; overflow:hidden; mask-image:linear-gradient(90deg,transparent,#000 3%,#000 97%,transparent); -webkit-mask-image:linear-gradient(90deg,transparent,#000 3%,#000 97%,transparent); }
  .recognition-viewport:focus-visible { outline:2px solid #7b9b87; outline-offset:5px; }
  .recognition-track { display:flex; width:max-content; animation:recognition-drift 90s linear infinite; animation-play-state:paused; }
  .recognition-group { display:flex; flex-shrink:0; gap:var(--recognition-gap); list-style:none; margin:0; padding:0 var(--recognition-gap) 0 0; }
  .recognition-item { display:flex; align-items:center; justify-content:center; flex:0 0 var(--recognition-item-width); width:var(--recognition-item-width); height:80px; }
  .recognition-item img { display:block; width:100%; height:100%; object-fit:contain; }
  .recognition-marquee[data-in-view="true"][data-document-visible="true"][data-paused="false"] .recognition-track { animation-play-state:running; }
  .recognition-marquee:focus-within .recognition-track { animation-play-state:paused!important; }
  @media(hover:hover) and (pointer:fine) { .recognition-marquee:hover .recognition-track { animation-play-state:paused!important; } }
  @media(max-width:600px) {
    .recognition-marquee { --recognition-item-width:80px; --recognition-gap:12px; margin-bottom:24px; padding:4px 40px 14px 0; }
    .recognition-item { height:64px; }
    .recognition-toggle { top:calc(50% - 7px); width:32px; height:32px; }
    .recognition-toggle::before { inset:-6px; }
  }
  @keyframes recognition-drift { to { transform:translateX(-50%); } }
  @media(prefers-reduced-motion:reduce) {
    .recognition-marquee { padding-right:0; }
    .recognition-viewport { overflow-x:auto; mask-image:none; -webkit-mask-image:none; padding-bottom:8px; }
    .recognition-track { animation:none!important; transform:none!important; }
    .recognition-copy,.recognition-toggle { display:none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-recognition-marquee]').forEach(root => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-recognition-toggle]');
    const label = root.querySelector<HTMLElement>('[data-recognition-toggle-label]');
    if (!toggle || !label) return;

    toggle.addEventListener('click', () => {
      const paused = root.dataset.paused !== 'true';
      root.dataset.paused = String(paused);
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.setAttribute('aria-label', `${paused ? 'Resume' : 'Pause'} recognition animation`);
      label.textContent = paused ? 'Resume' : 'Pause';
    });

    const updateVisibility = () => { root.dataset.documentVisible = String(!document.hidden); };
    updateVisibility();
    document.addEventListener('visibilitychange', updateVisibility);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => { root.dataset.inView = String(entry.isIntersecting); });
      }, { threshold:0.01 });
      observer.observe(root);
    } else root.dataset.inView = 'true';
  });
</script>

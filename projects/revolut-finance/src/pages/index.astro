<div class="orbital-ring ring-one">
</div>
<div class="orbital-ring ring-two">
</div>
<div class="phone-wrap">
<Phone client:load/>
</div>
<div class="floating-tag tag-one">
<span>↙</span>
<div>
<small>Money received</small>
<b>+ €3,200.00</b>
</div>
<i>✓</i>
</div>
<div class="floating-tag tag-two">
<span>↗</span>
<div>
<small>Your money, growing</small>
<b>A future worth saving for.</b>
</div>
</div>
<span class="visual-caption">DESIGNED FOR LIFE IN MOTION</span>
</div>
<a href="#experience" class="scroll-cue">SCROLL TO EXPLORE <span>↓</span>
</a>
<span class="hero-index">01 / A WORLD OF POSSIBILITY</span>
</section>
<div class="concept-strip" id="experience">
<p>Independent Fintech Website Concept — Created for Portfolio Demonstration.</p>
<span>DESIGN WITHOUT BOUNDARIES ↗</span>
</div>
<section id="banking" class="section banking">
<div class="section-heading reveal">

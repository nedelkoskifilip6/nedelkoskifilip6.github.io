---
import '../styles/global.css';
import '../styles/editorial.css';
import '../styles/cinematic.css';
import {Navigation} from '../components/Navigation';
import {DemoDialog} from '../components/DemoDialog';
import {Phone,Banking,Exchange,Cards,Savings,Security,Investments,Plans} from '../components/Experience';
const assetBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const photo = (name: string, width: number) => `${assetBase}/images/editorial/${name}-${width}.webp`;
const socialImage = 'https://nedelkoskifilip6.github.io/revolut-finance/social/hero-preview-20261014.jpg';
const socialImageAlt = 'Hero of an independent Revolut-inspired portfolio concept, with the Revolut wordmark, Banking & Beyond headline and Download the app button over a surfing photograph.';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content="#111114"/>
<meta name="description" content="An independent Revolut-inspired fintech portfolio concept by Filip Nedelkoski. Explore interactive banking, cards, savings and investment demonstrations."/>
<link rel="canonical" href="https://nedelkoskifilip6.github.io/revolut-finance/"/>
<link rel="icon" type="image/x-icon" sizes="16x16 32x32" href={`${assetBase}/favicon.ico?v=revolut-r-2`}/>
<link rel="icon" type="image/png" sizes="32x32" href={`${assetBase}/favicon-32x32.png?v=revolut-r-2`}/>
<link rel="icon" type="image/png" sizes="16x16" href={`${assetBase}/favicon-16x16.png?v=revolut-r-2`}/>
<link rel="apple-touch-icon" sizes="180x180" href={`${assetBase}/apple-touch-icon.png`}/>
<meta property="og:type" content="website"/>
<meta property="og:url" content="https://nedelkoskifilip6.github.io/revolut-finance/"/>
<meta property="og:site_name" content="Revolut Finance"/>
<meta property="og:title" content="Revolut Finance — Banking &amp; Beyond"/>
<meta property="og:description" content="An independent fintech website concept by Filip Nedelkoski."/>
<meta property="og:image" content={socialImage}/>
<meta property="og:image:secure_url" content={socialImage}/>
<meta property="og:image:type" content="image/jpeg"/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="675"/>
<meta property="og:image:alt" content={socialImageAlt}/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content="Revolut Finance — Banking &amp; Beyond"/>
<meta name="twitter:description" content="An independent fintech website concept by Filip Nedelkoski."/>
<meta name="twitter:image" content={socialImage}/>
<meta name="twitter:image:alt" content={socialImageAlt}/>
<title>Revolut Finance — Banking &amp; Beyond</title>
</head>
<body>
<a href="#main" class="skip-link">Skip to content</a>
<Navigation client:load/>
<main id="main">
<div class="cinematic-journey">
<section class="hero" aria-labelledby="hero-title">
<picture class="hero-photograph">
<source media="(max-width: 600px)" srcset={`${photo('surf-mobile',640)} 640w, ${photo('surf-mobile',960)} 960w`}/>
<img class="hero-photo" src={photo('surf',1600)} srcset={`${photo('surf',960)} 960w, ${photo('surf',1600)} 1600w, ${photo('surf',3200)} 3200w`} sizes="100vw" alt="A surfer paddling over coral in clear turquoise ocean water" width="3200" height="2132" fetchpriority="high" decoding="async"/>
</picture>
<div class="hero-text">
<span class="eyebrow">AN UNOFFICIAL PORTFOLIO EXPERIENCE</span>
<h1 id="hero-title"><span class="hero-title-line"><span>Banking &amp;</span></span><span class="hero-title-line"><span>Beyond</span></span></h1>
<div class="hero-description">
<p>Experience a smarter, simpler way<br class="desktop-break"/> to manage your money.</p>
<a class="button" href="https://revolut.com/app" target="_blank" rel="noopener noreferrer" aria-label="Download the app — official Revolut website (opens in a new tab)">Download the app</a>
<small class="external-note">Official Revolut website · external link</small>
</div>
</div>
<span class="hero-caption">YOUR EVERYDAY. REIMAGINED.</span>
</section>
<div class="cinematic-runway" aria-hidden="true"></div>
<div class="concept-strip" id="experience">
<p>Independent Fintech Website Concept — Created for Portfolio Demonstration.</p>
<span>BY FILIP NEDELKOSKI</span>
</div>
<section id="banking" class="section banking">
<div class="section-heading">
<div>
<span class="eyebrow">01 — EVERYDAY, ELEVATED</span>
<h2><span class="banking-title-line"><span>Your Money,</span></span><span class="banking-title-line"><span>Beautifully Organized.</span></span></h2>
</div>
<p>Less mental maths. More living.<br/>Bring every balance, every purchase and every possibility into focus.</p>
</div>
<div class="banking-presentation">
<div class="banking-story reveal"><span class="eyebrow">MADE FOR YOUR EVERYDAY</span><h3>A little less admin.<br/>A lot more life.</h3><p>Your balances, your spending, your goals. A considered demonstration of how it all comes together.</p><div class="story-detail"><b>All in one place.</b><span>Explore the app preview, then try the dashboard below.</span></div></div>
<div class="device-stage reveal"><div class="phone-wrap"><Phone client:visible={{ rootMargin: '250px' }}/></div><span class="device-caption">FICTIONAL ACCOUNT · INTERACTIVE APP PREVIEW</span></div>
</div>
<div class="reveal">
<Banking client:idle={{ timeout: 1200 }}/>
</div>
<div class="feature-row">
<div>
<b>The whole picture</b>
<p>All your demo balances, together.</p>
</div>
<div>
<span>◎</span>
<b>Space for your goals</b>
<p>Make room for what comes next.</p>
</div>
<div>
<span>⌘</span>
<b>Insights that make sense</b>
<p>Understand the way you spend.</p>
</div>
</div>
</section>
</div>
<section id="payments" class="section payments">
<div class="section-heading motion-heading"><div><span class="eyebrow">02 — GO A LITTLE FURTHER</span><h2><span class="heading-line"><span>Money Without</span></span><span class="heading-line"><span>Borders.</span></span></h2></div><p>Different currencies. The same possibilities.<br/>A demonstration of an exchange experience made to feel effortless.</p></div>
<div class="travel-composition">
<figure class="travel-photograph"><img class="editorial-photo" src={photo('voyage',1600)} srcset={`${photo('voyage',800)} 800w, ${photo('voyage',1600)} 1600w`} sizes="(max-width: 800px) 100vw, 55vw" alt="A white boat crossing sunlit turquoise water with a flowing wake" width="1600" height="2001" loading="lazy" decoding="async"/><figcaption>Go where life takes you.<span>A different perspective on travel</span></figcaption></figure>
<div class="travel-tools reveal"><span class="eyebrow">A WORLD OF POSSIBILITY</span><h3>New places.<br/>Familiar freedom.</h3><div class="currency-orbit" aria-hidden="true"><span>EUR</span><span>USD</span><span>GBP</span><span>JPY</span></div><Exchange client:idle={{ timeout: 1200 }}/></div>
</div>
</section>
<section id="cards" class="section cards-section">
<div class="cards-heading motion-heading">
<span class="eyebrow">03 — AN EXTENSION OF YOU</span>
<h2><span class="heading-line"><span>Designed to</span></span><span class="heading-line"><span>Stand Out.</span></span></h2>
<p>Considered in every detail. Confident in every finish.<br/>Meet a card that feels as good as it looks.</p>
</div>
<Cards client:idle={{ timeout: 1200 }}/>
<div class="card-footnote">
<span>PHYSICAL & VIRTUAL</span>
<span>FORM MEETS FUNCTION</span>
<span>CRAFTED FOR THE EVERYDAY</span>
</div>
</section>
<section id="savings" class="section savings">
<div class="savings-editorial">
<picture class="savings-photograph"><source media="(max-width: 600px)" srcset={`${photo('escape-mobile',640)} 640w, ${photo('escape-mobile',960)} 960w`}/><img class="editorial-photo" src={photo('escape',1600)} srcset={`${photo('escape',960)} 960w, ${photo('escape',1600)} 1600w, ${photo('escape',3200)} 3200w`} sizes="100vw" alt="Lush coastal mountains, a quiet beach and ocean in soft natural light" width="3200" height="2132" loading="lazy" decoding="async"/></picture>
<div class="savings-story motion-heading"><span class="eyebrow">04 — LITTLE STEPS. BIG PLANS.</span><h2><span class="heading-line"><span>Make Every</span></span><span class="heading-line"><span>Goal Possible.</span></span></h2><p>That trip. That space. That fresh start.<br/>Make room for the life you imagine.</p><span class="photo-label">A NEW ADVENTURE STARTS WITH A SMALL STEP.</span></div>
</div>
<div class="savings-tools"><div class="tools-heading"><h3>Your next chapter, in numbers.</h3><p>Select a demo goal. Set your monthly contribution. See what’s possible.</p></div>
<div class="reveal">
<Savings client:idle={{ timeout: 1200 }}/>
</div>
</div>
</section>
<section id="security" class="section security">
<div class="split">
<div class="section-copy motion-heading">
<span class="eyebrow">05 — PEACE OF MIND, BY DESIGN</span>
<h2><span class="heading-line"><span>Confidence</span></span><span class="heading-line"><span>in Every</span></span><span class="heading-line"><span>Transaction.</span></span></h2>
<p>Control that’s always close. Explore instant card freezing, thoughtful privacy controls and a simpler way to stay informed.</p>
<div class="security-note">
<span>✳</span>
<div>
<b>Protection, considered.</b>
<small>Fraud awareness and biometric concepts.<br/>Demonstration only — no real security services.</small>
</div>
</div>
</div>
<div class="reveal">
<Security client:idle={{ timeout: 1200 }}/>
</div>
</div>
</section>
<section id="invest" class="section investments">
<div class="section-heading motion-heading">
<div>
<span class="eyebrow">06 — THINK LONGER TERM</span>
<h2><span class="heading-line"><span>Your Future</span></span><span class="heading-line"><span>Starts Today.</span></span></h2>
</div>
<p>A clearer view of what could come next.<br/>Explore a portfolio experience that puts your perspective first.</p>
</div>
<div class="reveal">
<Investments client:idle={{ timeout: 1200 }}/>
</div>
</section>
<section id="plans" class="section plans">
<div class="center-heading motion-heading">
<span class="eyebrow">07 — YOUR LIFE. YOUR LEVEL.</span>
<h2><span class="heading-line"><span>Find your kind</span></span><span class="heading-line"><span>of extraordinary.</span></span></h2>
<p>Four fictional plans. A world of possibility.<br/>Choose a demonstration experience that feels like you.</p>
</div>
<Plans client:idle={{ timeout: 1200 }}/>
<p class="plan-disclaimer">All plan names, prices and benefits are fictional. These are not official Revolut offerings.</p>
</section>
<section class="final-cta">
<div class="cta-light" aria-hidden="true"></div>
<div class="motion-heading">
<span class="eyebrow">READY FOR A DIFFERENT PERSPECTIVE?</span>
<h2><span class="heading-line"><span>The Future of</span></span><span class="heading-line"><span>Finance Is Here.</span></span></h2>
<p>An independent perspective on what comes next.</p>
<a class="button" href="#banking">Step into the experience </a>
</div>
<span class="cta-bottom">YOUR MONEY. YOUR WORLD. YOUR FUTURE.</span>
</section>
</main>
<footer>
<div class="footer-top">
<div>
<a class="brand" href="#" aria-label="Portfolio concept home">
<img class="revolut-logo" src={`${assetBase}/brand/revolut-black.svg`} alt="Revolut" width="110" height="28"/>
<small class="brand-concept">Independent concept</small>
</a>
<p>A new perspective on money.<br/>An independent perspective on design.</p>
</div>
<div>
<b>Explore</b>
<a href="#banking">Personal banking</a>
<a href="#payments">Global payments</a>
<a href="#cards">Premium cards</a>
</div>
<div>
<b>Your future</b>
<a href="#savings">Savings goals</a>
<a href="#invest">Investment demo</a>
<a href="#plans">Compare plans</a>
</div>
<div>
<b>The project</b>
<a href="#security">Security concepts</a>
<a href="#legal">Legal & privacy</a>
<a href="https://nedelkoskifilip6.github.io/">More by Filip </a>
<a href="https://github.com/nedelkoskifilip6/nedelkoskifilip6.github.io" target="_blank" rel="noopener noreferrer">GitHub </a>
</div>
</div>
<div id="legal" class="legal">
<p>
<b>Independent Fintech Website Concept — Created for Portfolio Demonstration.</b>
</p>
<p>Created by Filip Nedelkoski. This unofficial concept is inspired by Revolut’s design language and is not affiliated with, endorsed by, or operated by Revolut. Revolut wordmarks identify the design inspiration only. All balances, transactions, currency rates, market data, cards and plan prices are illustrative. No banking, payment, investment or authentication services are provided. Interactions run locally in your browser; this project does not collect account credentials or send financial data.</p>
</div>
<div class="footer-bottom">
<span>© 2026 Filip Nedelkoski</span>
<span>DESIGNED WITH INTENTION. BUILT WITH PRECISION.</span>
<a href="#">Back to top </a>
</div>
</footer>
<DemoDialog client:load/>
<script>
import { initializeMotion } from '../scripts/motion';
import { initializeAnchorNavigation } from '../scripts/anchorNavigation';
initializeMotion();
initializeAnchorNavigation();
document.addEventListener('keydown',e=>{if(e.key==='Escape'){document.querySelector<HTMLButtonElement>('.close-modal')?.click();}});
document.addEventListener('keydown',e=>{const dialog=document.querySelector<HTMLElement>('[role="dialog"]');if(!dialog||e.key!=='Tab')return;const nodes=Array.from(dialog.querySelectorAll<HTMLElement>('button,a[href],input,select'));const first=nodes[0],last=nodes[nodes.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last?.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first?.focus();}});
</script>
</body>
</html>

<div id="legal" class="legal">
<p>
<b>Independent Fintech Website Concept — Created for Portfolio Demonstration.</b>
</p>
<p>Created by Filip Nedelkoski. This unofficial concept is inspired by Revolut’s design language and is not affiliated with, endorsed by, or operated by Revolut. Revolut wordmarks identify the design inspiration only. Orbit card artwork is fictional and original. All balances, transactions, currency rates, market data, cards and plan prices are illustrative. No banking, payment, investment or authentication services are provided. Interactions run locally in your browser; this project does not collect account credentials or send financial data.</p>
</div>
<div class="footer-bottom">
<span>© 2026 Filip Nedelkoski</span>
<span>DESIGNED WITH INTENTION. BUILT WITH PRECISION.</span>
<a href="#">Back to top ↑</a>
</div>
</footer>
<DemoDialog client:load/>
<script>
import gsap from 'gsap';
import {ScrollTrigger} from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);
const mm=gsap.matchMedia();
mm.add('(prefers-reduced-motion: no-preference)',()=>{
 gsap.from('.hero-text > *',{y:35,opacity:0,duration:1,stagger:.12,ease:'power3.out'});
 gsap.from('.phone-wrap',{y:100,rotation:10,opacity:0,duration:1.5,ease:'power3.out',delay:.15});
 gsap.from('.floating-tag, .hero-product-photo',{y:25,opacity:0,duration:1,delay:1,stagger:.2});
 gsap.to('.hero-product-photo',{y:-12,duration:3,ease:'sine.inOut',repeat:-1,yoyo:true});
 gsap.to('.phone-wrap',{y:-55,rotation:-3,ease:'none',scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:1}});
 gsap.utils.toArray<HTMLElement>('.reveal').forEach(el=>gsap.from(el,{y:45,opacity:0,duration:.9,ease:'power3.out',scrollTrigger:{trigger:el,start:'top 91%',once:true}}));
 gsap.to('.cta-orbit',{rotation:90,ease:'none',scrollTrigger:{trigger:'.final-cta',start:'top bottom',end:'bottom top',scrub:1}});
});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){document.querySelector<HTMLButtonElement>('.close-modal')?.click();}});
document.addEventListener('keydown',e=>{const dialog=document.querySelector<HTMLElement>('[role="dialog"]');if(!dialog||e.key!=='Tab')return;const nodes=Array.from(dialog.querySelectorAll<HTMLElement>('button,a[href],input,select'));const first=nodes[0],last=nodes[nodes.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last?.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first?.focus();}});
</script>
</body>
</html>

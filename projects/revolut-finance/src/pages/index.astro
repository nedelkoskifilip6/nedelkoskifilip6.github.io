---
import '../styles/global.css';
import {Navigation,Phone,Banking,Exchange,Cards,Savings,Security,Investments,Plans,DemoDialog} from '../components/Experience';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content="#111114"/>
<meta name="description" content="An independent Revolut-inspired fintech portfolio concept by Filip Nedelkoski. Explore interactive banking, cards, savings and investment demonstrations."/>
<link rel="canonical" href="https://nedelkoskifilip6.github.io/revolut-finance/"/>
<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`}/>
<meta property="og:title" content="Revolut-inspired Concept — Banking, Beyond Ordinary."/>
<meta property="og:description" content="An independent fintech website concept by Filip Nedelkoski."/>
<title>Revolut-inspired Concept — Banking, Beyond Ordinary.</title>
</head>
<body>
<a href="#main" class="skip-link">Skip to content</a>
<Navigation client:load/>
<main id="main">
<section class="hero" aria-labelledby="hero-title">
<div class="hero-text">
<div class="eyebrow">
<span class="status-dot">
</span> INDEPENDENT REVOLUT-INSPIRED CONCEPT</div>
<h1 id="hero-title">Banking,<br/>Beyond<br/>
<span>Ordinary.</span>
</h1>
